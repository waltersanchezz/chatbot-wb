# =============================================================================
# Rodacenter AI — variables de entorno
# Copiar a .env y completar.
# Producción (NODE_ENV=production) FAIL-FAST si faltan:
#   JWT_SECRET (≥32, no default), AUTH_ADMIN_PASSWORD (no admin123),
#   AUTH_REQUIRED=true, SQLITE_PATH durable (no :memory:),
#   WHATSAPP_VERIFY_TOKEN (no default), WHATSAPP_APP_SECRET,
#   WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
# Ver docs/PRODUCTION_CERTIFICATION.md y docs/PRODUCTION_RUNBOOK_PS1.md
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# App
APP_NAME=Rodacenter AI
COMPANY_NAME=Rodacenter Manizales
TENANT_ID=rodacenter

# Persistencia (Production Sprint 1)
# En Render con disco: DATA_DIR=/var/data
DATA_DIR=data
SQLITE_PATH=
LOG_DIR=
# Idempotencia WhatsApp (default: DATA_DIR/whatsapp-processed-wamids.json)
WHATSAPP_IDEMPOTENCY_PATH=

# Auth (obligatorio fuerte en NODE_ENV=production)
JWT_SECRET=rodacenter-dev-jwt-secret-change-me
JWT_TTL_SECONDS=28800
AUTH_ADMIN_EMAIL=admin@rodacenter.local
AUTH_ADMIN_PASSWORD=admin123
AUTH_ADMIN_NAME=Admin Rodacenter
AUTH_REQUIRED=true

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=rodacenter_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# App Secret de Meta → firma X-Hub-Signature-256 (obligatorio en production)
WHATSAPP_APP_SECRET=
# Forzar verificación de firma fuera de production (tests/staging): true|false
WHATSAPP_SIGNATURE_REQUIRED=
# Montar /api/debug solo en non-production: true|false
WHATSAPP_DEBUG_API=false

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=rule-based

# Logging / conversación
LOG_LEVEL=info
SESSION_TTL_MINUTES=120
RECOVERY_TTL_MINUTES=1440
PERSISTENCE_TTL_MINUTES=1440

# Timeouts (ms)
TIMEOUT_ENGINE_MS=8000
TIMEOUT_MESSAGING_MS=6000
TIMEOUT_PERSISTENCE_MS=3000
TIMEOUT_CRM_MS=5000

# Telegram notifications (leads / handoff)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
