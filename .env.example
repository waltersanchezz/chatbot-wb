# Server
PORT=3000
NODE_ENV=development

# App
APP_NAME=Rodacenter AI
COMPANY_NAME=Rodacenter Manizales

# WhatsApp Cloud API (futuro / opcional)
WHATSAPP_VERIFY_TOKEN=rodacenter_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# OpenAI (futuro / opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=rule-based

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Conversation
SESSION_TTL_MINUTES=120

# Telegram notifications (leads CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
