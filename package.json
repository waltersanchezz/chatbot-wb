{
  "name": "rodacenter-ai",
  "version": "1.0.0",
  "description": "Asistente inteligente WhatsApp Business para Rodacenter Manizales — baterías y rodamientos",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "node -e \"const fs=require('fs'); const p='node_modules/@types/node/package.json'; if(!fs.existsSync(p)){console.error('FATAL: missing '+p+' — @types/node must be installed before tsc'); process.exit(1)} console.log('prebuild: @types/node OK ->', require('./'+p).version)\"",
    "build": "tsc -p tsconfig.json",
    "dashboard:build": "npm --prefix apps/dashboard ci && npm --prefix apps/dashboard run build",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "build:production": "npm run build && npm run dashboard:build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:willard": "vitest run tests/willard",
    "test:hardening": "vitest run tests/willard/hardeningErrors.test.ts tests/willard/hardeningObservability.test.ts",
    "test:hardening:coverage": "vitest run tests/willard/hardeningErrors.test.ts tests/willard/hardeningObservability.test.ts --coverage",
    "test:knowledge": "vitest run tests/willard/knowledgeEngine.test.ts",
    "test:knowledge:coverage": "vitest run tests/willard/knowledgeEngine.test.ts --coverage",
    "test:advisor": "vitest run tests/willard/smartAdvisorIntegration.test.ts",
    "test:advisor:coverage": "vitest run tests/willard/smartAdvisorIntegration.test.ts --coverage --coverage.include=src/application/services/technicalQuestionDetector.ts --coverage.include=src/application/services/ConversationEngine.ts",
    "test:recovery": "vitest run tests/willard/conversationRecovery.test.ts",
    "test:recovery:coverage": "vitest run tests/willard/conversationRecovery.test.ts --coverage --coverage.include=src/application/services/ConversationMemory.ts --coverage.include=src/application/services/ConversationRecoveryEngine.ts",
    "test:persistence": "vitest run tests/willard/sqlitePersistence.test.ts",
    "test:persistence:coverage": "vitest run tests/willard/sqlitePersistence.test.ts --coverage --coverage.include=src/infrastructure/persistence/SQLitePersistenceRepository.ts --coverage.include=src/domain/persistence/persistedSession.ts --coverage.include=src/domain/ports/PersistenceRepository.ts",
    "test:learning": "vitest run tests/willard/learningEngine.test.ts",
    "test:learning:coverage": "vitest run tests/willard/learningEngine.test.ts --coverage --coverage.include=src/application/services/LearningEngine.ts --coverage.include=src/infrastructure/persistence/SQLiteLearningRepository.ts",
    "test:dashboard-api": "vitest run tests/willard/dashboardApi.test.ts",
    "test:conversations-api": "vitest run tests/willard/conversationsApi.test.ts",
    "test:conversation-detail-api": "vitest run tests/willard/conversationDetailApi.test.ts",
    "test:clients-api": "vitest run tests/willard/clientsApi.test.ts",
    "test:pipeline-api": "vitest run tests/willard/pipelineApi.test.ts",
    "test:tasks-api": "vitest run tests/willard/tasksApi.test.ts",
    "test:analytics-api": "vitest run tests/willard/analyticsApi.test.ts",
    "test:realtime-sse": "vitest run tests/willard/realtimeSse.test.ts",
    "test:multi-tenant": "vitest run tests/willard/multiTenant.test.ts",
    "test:auth-api": "vitest run tests/willard/authApi.test.ts",
    "test:company-api": "vitest run tests/willard/companyApi.test.ts",
    "test:company-api:coverage": "vitest run tests/willard/companyApi.test.ts --coverage --coverage.include=src/application/services/CompanyService.ts --coverage.include=src/infrastructure/persistence/SQLiteCompanyRepository.ts --coverage.include=src/presentation/http/routes/companyApiRoutes.ts --coverage.include=src/domain/dashboard/companyDto.ts",
    "test:onboarding-api": "vitest run tests/willard/onboardingApi.test.ts",
    "test:onboarding-api:coverage": "vitest run tests/willard/onboardingApi.test.ts --coverage --coverage.include=src/application/services/OnboardingService.ts --coverage.include=src/infrastructure/persistence/SQLiteOnboardingRepository.ts --coverage.include=src/presentation/http/routes/onboardingApiRoutes.ts --coverage.include=src/domain/dashboard/onboardingDto.ts",
    "test:knowledge-api": "vitest run tests/willard/knowledgeApi.test.ts",
    "test:knowledge-api:coverage": "vitest run tests/willard/knowledgeApi.test.ts --coverage --coverage.include=src/application/services/KnowledgeService.ts --coverage.include=src/infrastructure/persistence/SQLiteKnowledgeRepository.ts --coverage.include=src/presentation/http/routes/knowledgeApiRoutes.ts --coverage.include=src/domain/dashboard/knowledgeItemDto.ts",
    "test:automations-api": "vitest run tests/willard/automationsApi.test.ts",
    "test:automations-api:coverage": "vitest run tests/willard/automationsApi.test.ts --coverage --coverage.include=src/application/services/AutomationService.ts --coverage.include=src/infrastructure/persistence/SQLiteAutomationRepository.ts --coverage.include=src/presentation/http/routes/automationsApiRoutes.ts --coverage.include=src/domain/dashboard/automationDto.ts",
    "test:workflows-api": "vitest run tests/willard/workflowsApi.test.ts",
    "test:workflows-api:coverage": "vitest run tests/willard/workflowsApi.test.ts --coverage --coverage.include=src/application/services/WorkflowService.ts --coverage.include=src/infrastructure/persistence/SQLiteWorkflowRepository.ts --coverage.include=src/presentation/http/routes/workflowsApiRoutes.ts --coverage.include=src/domain/dashboard/workflowDto.ts",
    "test:billing-api": "vitest run tests/willard/billingApi.test.ts",
    "test:billing-api:coverage": "vitest run tests/willard/billingApi.test.ts --coverage --coverage.include=src/application/services/BillingService.ts --coverage.include=src/infrastructure/persistence/SQLiteBillingRepository.ts --coverage.include=src/presentation/http/routes/billingApiRoutes.ts --coverage.include=src/domain/dashboard/billingDto.ts",
    "test:marketplace-api": "vitest run tests/willard/marketplaceApi.test.ts",
    "test:marketplace-api:coverage": "vitest run tests/willard/marketplaceApi.test.ts --coverage --coverage.include=src/application/services/MarketplaceService.ts --coverage.include=src/infrastructure/persistence/SQLiteTemplateRepository.ts --coverage.include=src/infrastructure/persistence/templateSeeds.ts --coverage.include=src/presentation/http/routes/marketplaceApiRoutes.ts --coverage.include=src/domain/dashboard/templateDto.ts",
    "test:copilot-api": "vitest run tests/willard/copilotApi.test.ts",
    "test:copilot-api:coverage": "vitest run tests/willard/copilotApi.test.ts --coverage --coverage.include=src/application/services/CopilotService.ts --coverage.include=src/infrastructure/persistence/SQLitePromptRepository.ts --coverage.include=src/infrastructure/ai/LocalPromptProvider.ts --coverage.include=src/presentation/http/routes/copilotApiRoutes.ts --coverage.include=src/domain/dashboard/copilotDto.ts --coverage.include=src/domain/copilot/AiProvider.ts",
    "test:integrations-api": "vitest run tests/willard/integrationsApi.test.ts",
    "test:integrations-api:coverage": "vitest run tests/willard/integrationsApi.test.ts --coverage --coverage.include=src/application/services/IntegrationService.ts --coverage.include=src/infrastructure/persistence/SQLiteConnectorRepository.ts --coverage.include=src/infrastructure/integrations/mockConnectors.ts --coverage.include=src/presentation/http/routes/integrationsApiRoutes.ts --coverage.include=src/domain/dashboard/connectorDto.ts",
    "test:observability-api": "vitest run tests/willard/observabilityApi.test.ts",
    "test:observability-api:coverage": "vitest run tests/willard/observabilityApi.test.ts --coverage --coverage.include=src/application/services/ObservabilityService.ts --coverage.include=src/infrastructure/persistence/SQLiteObservabilityRepository.ts --coverage.include=src/presentation/http/routes/observabilityApiRoutes.ts --coverage.include=src/domain/dashboard/observabilityDto.ts",
    "test:developer-api": "vitest run tests/willard/developerApi.test.ts",
    "test:developer-api:coverage": "vitest run tests/willard/developerApi.test.ts --coverage --coverage.include=src/application/services/DeveloperService.ts --coverage.include=src/infrastructure/persistence/SQLiteApiKeyRepository.ts --coverage.include=src/presentation/http/routes/developerApiRoutes.ts --coverage.include=src/domain/dashboard/developerDto.ts",
    "test:production-sprint1": "vitest run tests/willard/productionSprint1.test.ts",
    "test:production-sprint1:coverage": "vitest run tests/willard/productionSprint1.test.ts --coverage --coverage.include=src/infrastructure/messaging/whatsappSignature.ts --coverage.include=src/infrastructure/config/productionGuard.ts --coverage.include=src/presentation/http/routes/whatsappRoutes.ts",
    "test:production-sprint2": "vitest run tests/willard/productionSprint2.test.ts",
    "test:production-sprint2:coverage": "vitest run tests/willard/productionSprint2.test.ts --coverage --coverage.include=src/infrastructure/persistence/SQLiteCustomerRepository.ts --coverage.include=src/infrastructure/persistence/SQLiteLeadRepository.ts --coverage.include=src/infrastructure/persistence/SQLiteInteractionRepository.ts --coverage.include=src/infrastructure/persistence/SQLiteVehicleProfileRepository.ts --coverage.include=src/infrastructure/persistence/SQLiteChatConversationRepository.ts --coverage.include=src/infrastructure/persistence/crmSqlite.ts --coverage.include=src/infrastructure/persistence/crmSerialize.ts --coverage.include=src/domain/crm/leadListFilter.ts",
    "test:production-sprint3": "vitest run tests/willard/productionSprint3.test.ts",
    "test:production-sprint3:coverage": "vitest run tests/willard/productionSprint3.test.ts --coverage --coverage.include=src/presentation/http/routes/dashboardRoutes.ts",
    "test:production-sprint4": "vitest run tests/willard/productionSprint4.test.ts tests/willard/notificationTelegramRetry.test.ts",
    "test:production-sprint4:coverage": "vitest run tests/willard/productionSprint4.test.ts tests/willard/notificationTelegramRetry.test.ts --coverage --coverage.include=src/application/services/NotificationService.ts",
    "test:certification": "vitest run tests/willard/productionCertification.test.ts tests/willard/productionSprint1.test.ts tests/willard/productionSprint2.test.ts tests/willard/productionSprint3.test.ts tests/willard/productionSprint4.test.ts tests/willard/notificationTelegramRetry.test.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "rodacenter",
    "baterias",
    "rodamientos"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "24.13.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "typescript": "5.9.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
